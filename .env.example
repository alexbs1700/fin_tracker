# Copy to .env and fill in. .env is gitignored.
# Full name as it appears in bank transfer descriptions (accents optional)
OWNER_NAME="Nombre Apellido Apellido"
# Access key required by any device other than this Mac (e.g. your iPhone).
# Generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(18))"
FIN_TRACKER_ACCESS_KEY=""
# Set to 0.0.0.0 to reach the app from the iPhone on your WiFi (needs the key above)
# FIN_TRACKER_HOST="0.0.0.0"
